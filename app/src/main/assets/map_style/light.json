{
  "version": 8,
  "name": "Light",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tile.openstreetmap.jp/data/planet.json"
    }
  },
  "glyphs": "https://mierune.github.io/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f3f0"
      }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "residential",
          "suburb",
          "neighbourhood"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#eeede9"
      }
    },
    {
      "id": "landcover_green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "wood",
          "grass"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#e4ebdc"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#e4ebdc"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "!=",
        [
          "get",
          "intermittent"
        ],
        1
      ],
      "paint": {
        "fill-color": "#c8d7e3"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": [
        "!=",
        [
          "get",
          "brunnel"
        ],
        "tunnel"
      ],
      "paint": {
        "line-color": "#c8d7e3",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          18,
          6
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#e6e4df"
