      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans CJK JP Regular"
        ],
        "text-size": 12
      },
      "paint": {
        "text-color": "#7b93a8",
        "text-halo-color": "#f4f3f0",
        "text-halo-width": 1.2
      }
